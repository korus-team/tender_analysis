# Универсальная SMTP-настройка уведомлений DAR.
# Скопируйте файл в .env и заполните параметры своего почтового сервиса.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Для порта 465 обычно: SMTP_USE_SSL=1 и SMTP_USE_TLS=0.
# Для порта 587 обычно: SMTP_USE_SSL=0 и SMTP_USE_TLS=1.
SMTP_USE_SSL=0
SMTP_USE_TLS=1
SMTP_USERNAME=sender@example.com
SMTP_APP_PASSWORD=
EMAIL_FROM=sender@example.com
EMAIL_FROM_NAME=DAR Tender Assistant
EMAIL_TO=recipient@example.com
APP_BASE_URL=http://127.0.0.1:5000

# Анализ тендерной документации через OpenAI. Без ключа работает только
# локальный экспресс-анализ; ключ не добавляйте в Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# LLM-скоринг тендеров. При пустом значении используется OPENAI_MODEL.
OPENAI_TENDER_MODEL=
OPENAI_BASE_URL=
USE_LLM_SCORING=0 # 1 - вкл, 0 - выкл (старый scoring по ключевым словам и тд.)
# Проверка размера компании по ИНН использует открытый ГИР БО ФНС.
# API-ключ не требуется; результаты кэшируются локально.
FNS_GIR_BO_TIMEOUT_SECONDS=12
FNS_GIR_BO_CACHE_DAYS=30
# Пути можно переопределить; по умолчанию используются файлы из папки data.
COMPANY_NAME_REGISTRY_PATH=
COMPANY_VERIFIED_REGISTRY_PATH=

# Уровень серверных логов: DEBUG, INFO, WARNING или ERROR.
LOG_LEVEL=INFO
# Отдельный ротируемый журнал действий пользователей.
USER_ACTION_LOG_FILE=logs/user_actions.log
